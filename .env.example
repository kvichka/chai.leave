# -----------------------------------------------------------------------------
# Copy to .env.local for development.
#
# Both of these values are PUBLIC. They are compiled into the JavaScript bundle
# that GitHub Pages serves, and anyone can read them out of it. That is normal
# and expected for a Supabase SPA - the anon key only grants what Row Level
# Security allows. It is not a secret, and treating it as one creates false
# confidence. See README "Security model".
#
# The service_role key must NEVER appear in this file, in the repo, or in any
# frontend code.
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Defaults to /chai-leave/ - set this to /<your-repo-name>/ so the
# GitHub Pages asset paths resolve.
VITE_BASE_PATH=/chai-leave/


# -----------------------------------------------------------------------------
# Test-only. Used by tests/db/*, never by the app.
# `supabase start` prints these; they refer to the local stack on 127.0.0.1.
# -----------------------------------------------------------------------------
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional. Restricts sign-in to one email domain, e.g. clintonhealthaccess.org.
# Leave unset to allow any address an administrator has created an account for.
VITE_ALLOWED_EMAIL_DOMAIN=

# Optional, development only. Enables the one-click "Sign in as a demo user"
# panel on the login screen and is the password it uses. The panel does not
# render unless this is set, and Vite strips it from production builds either
# way. Only ever put a throwaway password for throwaway accounts here.
VITE_DEMO_PASSWORD=
